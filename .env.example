# CV LIFE SOLUTION TECHNOLOGY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local or .env.production and fill in real credentials on server

# Node Environment
NODE_ENV=production

# Database Connection (Supabase PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Session JWT Secret (Generate 64-char random string for production)
JWT_SECRET="your-super-secret-64-character-random-jwt-key-here"

# AI Service Keys (Server-Side Only - DO NOT add NEXT_PUBLIC_ prefix)
AI_PRIMARY_PROVIDER="openrouter" # Options: "openrouter" | "claude" | "gemini" | "openai"
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
OPENROUTER_MODEL="google/gemini-2.0-flash-001" # Examples: "google/gemini-2.0-flash-001", "openai/gpt-4o-mini", "anthropic/claude-3.5-haiku", "deepseek/deepseek-chat"

# Optional alternative direct providers
# ANTHROPIC_API_KEY="sk-ant-your-claude-api-key-here"
# OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
# GEMINI_API_KEY="your-google-gemini-api-key-here"

# Persistent Image/File Storage (Supabase Storage - files survive every redeploy)
# Dashboard -> Storage -> New bucket "media" (Public). Keys: Project Settings -> API Keys
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-secret-key"
SUPABASE_STORAGE_BUCKET="media"

# Server Host & Application URL
NEXT_PUBLIC_APP_URL="https://lifesolution.co.id"
